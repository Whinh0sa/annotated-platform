{
  "manifest_version": 3,
  "name": "Annotated (Manual Build)",
  "version": "1.0.0",
  "permissions": ["activeTab", "scripting", "storage", "tabCapture"],
  "action": {
    "default_title": "Annotate"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
